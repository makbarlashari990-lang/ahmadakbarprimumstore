rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Products ---
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'category', 'images', 'createdAt']) &&
             data.keys().size() >= 6 &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.images is list && data.images.size() > 0 &&
             data.createdAt is number;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();

      // --- Reviews ---
      function isValidReview(data) {
        return data.keys().hasAll(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.rating >= 1 && data.rating <= 5 &&
               data.comment is string && data.comment.size() <= 1000 &&
               data.createdAt == request.time.toMillis();
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isEmailVerified() && isValidReview(incoming());
        allow update: if isEmailVerified() && existing().userId == request.auth.uid &&
                       isValidReview(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
        allow delete: if isEmailVerified() && (existing().userId == request.auth.uid || isAdmin());
      }
    }

    // --- Orders ---
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'items', 'totalAmount', 'status', 'paymentMethod', 'shippingAddress', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.items is list && data.items.size() > 0 &&
             data.status in ['Pending', 'Processing', 'Shipped', 'Delivered', 'Cancelled'] &&
             data.createdAt == request.time.toMillis();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidOrder(incoming());
      allow update: if isAdmin() && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // --- Admins collection (protected) ---
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Only manageable through Firebase Console or Cloud Functions
    }
  }
}
